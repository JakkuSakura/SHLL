{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FerroPhase",
  "scopeName": "source.ferrophase",
  "patterns": [
    { "include": "#shebang" },
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#macros" },
    { "include": "#function-decl" },
    { "include": "#function-call" },
    { "include": "#types" },
    { "include": "#lifetimes" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "shebang": {
      "patterns": [
        {
          "name": "comment.line.shebang.ferrophase",
          "match": "^#!.*$"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.ferrophase",
          "match": "//[/!].*$"
        },
        {
          "name": "comment.line.double-slash.ferrophase",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ferrophase",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.ferrophase",
          "begin": "#!?\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.attribute.ferrophase" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.attribute.ferrophase" }
          },
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#comments" },
            {
              "name": "entity.other.attribute-name.ferrophase",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.ferrophase",
          "begin": "r#*\"",
          "end": "\"#*"
        },
        {
          "name": "string.quoted.double.ferrophase",
          "begin": "b?\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ferrophase",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|[nrt0\\\\'\"])"
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.ferrophase",
          "match": "b?'(\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|[nrt0\\\\'\"])|[^'\\\\])'"
        }
      ]
    },
    "lifetimes": {
      "patterns": [
        {
          "name": "storage.modifier.lifetime.ferrophase",
          "match": "'[A-Za-z_][A-Za-z0-9_]*\\b(?!')"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ferrophase",
          "match": "\\b0[xX][0-9A-Fa-f_]+(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize)?\\b"
        },
        {
          "name": "constant.numeric.binary.ferrophase",
          "match": "\\b0[bB][01_]+(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize)?\\b"
        },
        {
          "name": "constant.numeric.octal.ferrophase",
          "match": "\\b0[oO][0-7_]+(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize)?\\b"
        },
        {
          "name": "constant.numeric.float.ferrophase",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.decimal.ferrophase",
          "match": "\\b[0-9][0-9_]*(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ferrophase",
          "match": "\\b(if|else|match|loop|while|for|in|break|continue|return|try|catch|finally|await)\\b"
        },
        {
          "name": "keyword.control.metaprogramming.ferrophase",
          "match": "\\b(quote|splice|emit|gen|with|defer)\\b"
        },
        {
          "name": "storage.type.ferrophase",
          "match": "\\b(struct|enum|union|trait|type|mod|const|static|opaque|impl)\\b"
        },
        {
          "name": "storage.modifier.ferrophase",
          "match": "\\b(mut|pub|unsafe|async|move|extern|let|fn|use|where|as|super|crate)\\b"
        },
        {
          "name": "keyword.other.ferrophase",
          "match": "\\b(async|await)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ferrophase",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.self.ferrophase",
          "match": "\\bself\\b"
        },
        {
          "name": "variable.language.special.ferrophase",
          "match": "\\bSelf\\b"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "entity.name.function.macro.ferrophase",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*!(?=\\s*[\\(\\[\\{])"
        }
      ]
    },
    "function-decl": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.ferrophase" },
            "2": { "name": "entity.name.function.ferrophase" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "name": "entity.name.function.ferrophase",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*(::<[^>]*>\\s*)?\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.ferrophase",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ferrophase",
          "match": "(->|=>|::|\\.\\.=|\\.\\.\\.|\\.\\.|==|!=|<=|>=|&&|\\|\\||\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|<<|>>|[+\\-*/%=<>!&|^~@?#]|:)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.ferrophase",
          "match": "[,;]"
        },
        {
          "name": "punctuation.definition.parameters.ferrophase",
          "match": "[\\(\\)]"
        },
        {
          "name": "punctuation.definition.block.ferrophase",
          "match": "[\\{\\}]"
        },
        {
          "name": "punctuation.definition.array.ferrophase",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}
